#include <iostream>
using namespace std;


int power(int n) {
    return n * n;
}


int power(int n, int p) {
    return n * n * n;
}

int main() {
    int num;

    cout << "Enter a number: ";
    cin >> num;

    cout << "Square = " << power(num) << endl;
    cout << "Cube = " << power(num, 3) << endl;

    return 0;
}

