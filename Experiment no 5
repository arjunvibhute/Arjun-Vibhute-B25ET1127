#include <iostream>
using namespace std;

// Function to calculate square
int power(int n) {
    return n * n;
}

// Function to calculate cube
int power(int n, int p) {
    return n * n * n;
}

int main() {
    int num;

    cout << "Enter a number: ";
    cin >> num;

    cout << "Square = " << power(num) << endl;
    cout << "Cube = " << power(num, 3) << endl;

    return 0;
}

