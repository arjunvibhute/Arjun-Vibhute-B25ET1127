#include <iostream>
#include <cmath>
using namespace std;

class Complex {
    float real, imag;

public:
    void getData() {
        cout << "Enter real part: ";
        cin >> real;

        cout << "Enter imaginary part: ";
        cin >> imag;
    }

    float modulus() {
        return sqrt(real * real + imag * imag);
    }

    void display() {
        cout << "Complex number = " << real << " + " << imag << "i" << endl;
        cout << "Modulus = " << modulus() << endl;
    }
};

int main() {
    Complex c;

    c.getData();
    c.display();

    return 0;
}
